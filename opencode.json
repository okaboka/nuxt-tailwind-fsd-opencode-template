{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "workflow",
  "subagent_depth": 1,

  "instructions": [
    "AGENTS.md"
  ],

  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },

    "edit": {
      "*": "deny",
      "**/.git/**": "deny",
      ".git/**": "deny"
    },

    "bash": {
      "*": "deny",

      "git status": "allow",
      "git status --short": "allow",
      "git status --porcelain": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git diff --cached": "allow",
      "git log": "allow",
      "git log --oneline": "allow",
      "git show": "allow",
      "git show --stat": "allow",
      "git branch --list": "allow",
      "git rev-parse HEAD": "allow",
      "git ls-files": "allow",
      "git remote -v": "allow",
      "git tag --list": "allow",
      "npm run test": "allow",
      "npm test": "allow",
      "npx eslint .": "allow",

      "*;*": "deny",
      "*&&*": "deny",
      "*||*": "deny",
      "*|*": "deny",
      "*>*": "deny",
      "*>>*": "deny"
    },

    "task": "deny",
    "question": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",

    "skill": {
      "*": "allow",
      "nestjs-expert": "deny"
    }
  }
}
